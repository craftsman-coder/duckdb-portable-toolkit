# ==================================================================
# Portable DuckDB Toolkit - Central Configuration
# ==================================================================
# Edit this file before running `python setup.py`.
# All relative paths are resolved against the project root.
# ==================================================================

paths:
  project_root: "."
  runtime_dir:    "runtime"
  python_dir:     "runtime/python"
  venv_dir:       "runtime/venv"
  duckdb_dir:     "runtime/duckdb"
  extensions_dir: "runtime/duckdb/extensions"
  models_dir:     "runtime/duckdb/models"
  jobs_dir:       "jobs"
  configs_dir:    "configs"
  data_dir:       "data"
  exports_dir:    "exports"
  logs_dir:       "logs"
  mlruns_dir:     "mlruns"
  reports_dir:    "reports"

python:
  version: "3.12.7"        # any 3.12.x from python-build-standalone

pytorch:
  build: "cpu"             # cpu | cuda
  cuda_version: "cu121"

packages:
  core:            true
  jupyter:         true
  visualization:   true
  streamlit:       true
  eda:             true
  data_quality:    true
  notebook_tools:  true
  scheduling:      true
  ml:              true
  mlops:           true
  cloud:           true
  utilities:       true

extensions:
  core:
    - parquet
    - json
    - icu
    - httpfs
    - fts
    - vss
    - inet
    - iceberg
    - delta
    - ducklake
    - lance
  community:
    - paimon
    - qvd
    - pbix
    - oracle_scanner
    - postgres_scanner
    - mysql_scanner
    - sqlite_scanner
    - mssql
    - mongo
    - cassandra
    - odbc_scanner
    - ai
    - whisper

runtime:
  duckdb_memory_limit: "8GB"
  duckdb_threads: 4
  jupyter_port: 8888
  streamlit_port: 8501

scheduler:
  log_dir: "logs"
  timezone: "UTC"

setup:
  download_python:      true
  download_duckdb:      true
  install_packages:     true
  install_extensions:   true
  create_config_files:  true
  skip_existing:        true
  
# ==================================================================
# MCP Server for AI
# ==================================================================
mcp:
  enabled: true
  # Path to the DuckDB database that the AI can query.
  # Use ":memory:" for a temporary database, or a path to a .duckdb file.
  db_path: ":memory:"
  # Read-only mode for safety (recommended).
  read_only: true
  # Port for HTTP transport (optional, for advanced use).
  # When running over stdio (default), this is ignored.
  http_port: 8801
